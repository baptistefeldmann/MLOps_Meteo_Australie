# DagsHub credentials (get your token from DagsHub → Settings → Applications → User Tokens)
DAGSHUB_USERNAME=your_dagshub_username
DAGSHUB_USER_TOKEN=your_dagshub_token

# DVC push to DagsHub S3 (same token as above)
AWS_ACCESS_KEY_ID=your_dagshub_token
AWS_SECRET_ACCESS_KEY=your_dagshub_token

# GitHub PAT (GitHub → Settings → Developer settings → Tokens (classic) → repo scope)
GITHUB_TOKEN=your_github_token

# Absolute path to the project root on YOUR machine
HOST_PROJECT_PATH=/absolute/path/to/MLOps_Meteo_Australie

# Image used by the Airflow DAGs (dags/dag_data_pipeline.py, dags/dag_model_training.py) for their DockerOperator tasks.
# Defaults to the GHCR image built by CI on push to main, which is PRIVATE — pulling it anonymously fails with 403.
# For local testing, build the image yourself and point at it instead:
#   docker build -t mlops_meteo_australie-training:latest -f src/training/Dockerfile .
# TRAINING_IMAGE=mlops_meteo_australie-training:latest

# internal URL for prediction
API_PREDICTION_URL = 'http://api:8000/predict'

# Airflow secret key, can be anything like a none empty string
AIRFLOW__WEBSERVER__SECRET_KEY=my_secret_key

# Grafan secret keys
GF_SECURITY_ADMIN_USER=your_username
GF_SECURITY_ADMIN_PASSWORD=your_password
