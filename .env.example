# =============================================================================
# Configuration du projet — copier en `.env` puis renseigner les valeurs.
# Ce fichier est un modele : ne JAMAIS committer le `.env` reel (il est ignore).
# Format strict : PAS d'espace autour du `=`, pas de guillemets.
# =============================================================================

# --- DagsHub : MLflow (suivi + registre de modeles) et remote DVC -------------
# Token : DagsHub -> Settings -> Applications -> Tokens
DAGSHUB_USER_TOKEN=your_dagshub_token

# Le remote DVC est un stockage S3 DagsHub : les deux cles valent le MEME token.
AWS_ACCESS_KEY_ID=your_dagshub_token
AWS_SECRET_ACCESS_KEY=your_dagshub_token

# Proprietaire du depot DagsHub. Sert de `repo_owner` MLflow dans
# training.py, drift_report.py et predict.py : OBLIGATOIRE, sinon aucun
# modele n'est ni enregistre ni charge.
DAGSHUB_USERNAME=your_dagshub_username

# --- GitHub : commit automatique des pointeurs DVC par le DAG Airflow ---------
# Token "fine-grained" limite a CE seul depot, permission
# `Repository permissions -> Contents: Read and write`. Rien d'autre.
# (GitHub -> Settings -> Developer settings -> Personal access tokens)
# Un PAT "classic" avec le scope `repo` marche aussi, mais donne bien plus
# de droits que necessaire (tous vos depots, issues, settings, webhooks).
# Attention a la date d'expiration : le DAG tourne @monthly et un token mort
# fait echouer le commit APRES que les donnees ont ete poussees sur DVC.
GITHUB_TOKEN=your_github_token

# Depot vise par le `git push` automatique (DAG data_pipeline et
# src/pipelines/update_reference.sh).
GITHUB_USER=your_github_username
GITHUB_REPO=MLOps_Meteo_Australie

# --- Airflow -----------------------------------------------------------------
# Chemin ABSOLU du depot sur la machine hote : les taches DockerOperator le
# montent dans leurs conteneurs. Sans lui, les DAGs echouent.
HOST_PROJECT_PATH=/absolute/path/to/MLOps_Meteo_Australie

# Signe les echanges internes entre composants (dont la lecture des logs).
# Doit etre IDENTIQUE pour le webserver et le scheduler. Toute chaine non vide.
# Generer : openssl rand -hex 32
AIRFLOW__WEBSERVER__SECRET_KEY=my_secret_key

# GID du groupe proprietaire du socket Docker, pour que le scheduler puisse
# lancer des conteneurs.  Obtenir la valeur :  stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# --- API ---------------------------------------------------------------------
# Cle exigee par nginx (en-tete `x-api-key`) sur toutes les routes sauf /health.
# ATTENTION : si elle est vide, la regle nginx laisse passer les requetes SANS
# cle au lieu de tout bloquer. Toujours la renseigner.
API_KEY=change_me

# URL interne appelee par l'interface Streamlit (nom de service Docker).
API_PREDICTION_URL=http://api:8000/predict

# --- Interface Streamlit -----------------------------------------------------
# Liens ouverts depuis l'espace admin. Ce sont des URL vues par le NAVIGATEUR :
# en acces distant (port forwarding), mettre l'adresse reellement joignable.
GRAFANA_URL=http://localhost:3000
EVIDENTLY_URL=http://localhost:8888

# --- Monitoring --------------------------------------------------------------
GF_SECURITY_ADMIN_USER=your_username
GF_SECURITY_ADMIN_PASSWORD=your_password

# Webhook Slack pour les alertes Grafana (facultatif).
# Slack -> api.slack.com/apps -> Incoming Webhooks
WEBHOOK_SLACK_URL=https://hooks.slack.com/services/your-token-url

# --- Divers ------------------------------------------------------------------
# Ville par defaut du service `predict` (surchargeable en ligne de commande :
# CITY=Canberra docker compose run --rm predict)
CITY=Sydney

# NOTE : les DAGs Airflow utilisent l'image `mlops_meteo_australie-training`,
# dont le nom est code en dur dans dags/*.py. La construire au prealable avec :
#   docker compose build training
