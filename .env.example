# DagsHub credentials (get your token from DagsHub → Settings → Applications → User Tokens)
DAGSHUB_USERNAME=your_dagshub_username
DAGSHUB_USER_TOKEN=your_dagshub_token

# DVC push to DagsHub S3 (same token as above)
AWS_ACCESS_KEY_ID=your_dagshub_token
AWS_SECRET_ACCESS_KEY=your_dagshub_token

# GitHub PAT (GitHub → Settings → Developer settings → Tokens (classic) → repo scope)
GITHUB_TOKEN=your_github_token

# Absolute path to the project root on YOUR machine
HOST_PROJECT_PATH=/absolute/path/to/MLOps_Meteo_Australie
